<h1>New Application</h1>

<div class="card" >
    <div class="card-block" >
	<%= form_for :application, url: applications_path do |f| %>
	    <div class="form-group">
		<%= f.label :name %>
		<%= f.text_field :name, class: "form-control form-control-lg" %>
	    </div>
	    <div class="form-group">
		<%= f.label :description %>
		<%= f.text_field :description, class: "form-control" %>
	    </div>
	    <div class="form-group">
		<%= f.label :github_repo_url, 'GitHub repository URL' %>
		<%= f.text_field :github_repo_url, class: "form-control" %>
	    </div>
	    <div class="form-group">
		<%= f.label :type %>
		<%= f.select :type, {}, {}, {class: "form-control"} do %>
		    <%= options_for_select([['Server', 'server'], ['Cron job', 'cronjob']]) %>
		<% end %>
	    </div>
	    <%= link_to 'Cancel', applications_path, class: "btn" %>
	    <%= f.submit nil, class: "btn btn-primary" %>
	<% end %>
    </div>
</div>
