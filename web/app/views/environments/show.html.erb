<div class="card">
  <div class="card-header" >
    Environments
  </div>
  <div class="card-block" >
    <h4 class="card-title"><%= @environment.name %></h4>
    <h5>Environment Variables</h5>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Key</th>
          <th>Value</th>
          <th>Type</th>
          <th>Rate</th>
        </tr>
      </thead>
      <tbody>
        <% @environment_variables.each do |env_var| %>
          <tr scope="row">
            <td>
              <%= env_var.key %>
            </td>
            <td>
              <%= env_var.value %>
            </td>
            <td>
              <%= env_var.type %>
            </td>
            <td>
              <%= env_var.rate %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <div class="text-right mb-3">
    <a class="btn btn-primary" href="#">+ New Environment Variable</a>
  </div>
  <p class="card-text text-muted"><small>Created: <%= DateTime.strptime(@environment.createdAt, '%Y-%m-%dT%H:%M:%S').strftime('%b %-d, %Y') %></small></p>
  </div>
</div>
